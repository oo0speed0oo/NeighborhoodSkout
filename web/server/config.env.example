# NeighborhoodSkout settings. Edit config.env, then run:  systemctl --user restart skout
# Address to listen on. install.sh fills in your Tailscale address, so only your Tailscale devices can reach it.
SKOUT_HOST=127.0.0.1
SKOUT_PORT=8095
# Where the map, photos and snapshots are kept. Back up this one folder.
SKOUT_DATA=%HOME%/skout-data
# Optional login. Leave empty for none (Tailscale already limits who can connect). Any username works; this is the password.
SKOUT_PASSWORD=
